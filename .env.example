# Daret.ir Telegram Bot Configuration
# Get your bot token from @BotFather
TELEGRAM_API_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# In-memory doors catalog cache TTL in seconds (default: 300 = 5 minutes)
DOORS_CACHE_TTL_SECONDS=300

# Base URL of daret.ir website
DARET_BASE_URL=https://daret.ir

# HTTP request timeout in seconds
HTTP_TIMEOUT_SECONDS=15.0

# Maximum concurrent HTTP requests when scraping door details
SCRAPE_CONCURRENCY=5

# Telegram client cache TTL for inline query answers in seconds
INLINE_CACHE_TTL_SECONDS=10
